Mongo_Url=mongodb://localhost:27017/melodia
Secret_Key=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development

# Comma-separated frontend URLs allowed by CORS
# Example: CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CLIENT_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Image storage
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_URL_ENDPOINT=your_imagekit_url_endpoint

# Mailer (preferred: explicit SMTP config)
# MAIL_USER, MAIL_PASS, and MAIL_FROM must belong to the same Gmail account.
# MAIL_PASS must be a Google App Password, not the normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_sender_email@example.com
MAIL_PASS=your_app_password_or_smtp_password
MAIL_FROM=your_sender_email@example.com

# Legacy fallback vars (only use these when MAIL_* values are absent)
EMAIL_USER=your_sender_email@example.com
EMAIL_PASS=your_app_password_or_smtp_password

# Artist application recipients (supports comma-separated list)
ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Optional single fallback recipient
ADMIN_EMAIL=admin1@example.com
